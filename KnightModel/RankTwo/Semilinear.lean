import Mathlib.Algebra.Field.Rat
import Mathlib.Algebra.Module.Basic
import Mathlib.Algebra.Order.Module.Defs
import Mathlib.Data.Fin.Tuple.Basic

/-! # Affine terms and semilinear predicates over ordered rational vector spaces -/

namespace KnightModel.RankTwo.Semilinear

variable {V : Type*} {n m : ℕ}

/-- Affine expressions, allowing arbitrary named vector parameters. -/
inductive Term (V : Type*) (n : ℕ) where
  | var (i : Fin n)
  | const (c : V)
  | add (a b : Term V n)
  | scale (q : ℚ) (a : Term V n)

namespace Term

variable [AddCommGroup V] [Module ℚ V]

def eval : Term V n → (Fin n → V) → V
  | .var i, p => p i
  | .const c, _ => c
  | .add a b, p => a.eval p + b.eval p
  | .scale q a, p => q • a.eval p

/-- Simultaneous substitution for all free variables. -/
def subst (s : Fin n → Term V m) : Term V n → Term V m
  | .var i => s i
  | .const c => .const c
  | .add a b => .add (a.subst s) (b.subst s)
  | .scale q a => .scale q (a.subst s)

@[simp] theorem eval_subst (s : Fin n → Term V m) (t : Term V n) (p : Fin m → V) :
    (t.subst s).eval p = t.eval (fun i => (s i).eval p) := by
  induction t <;> simp_all [eval, subst]

/-- The rational coefficient of the variable being eliminated. -/
def slope : Term V (n+1) → ℚ
  | .var i => Fin.cases 1 (fun _ => 0) i
  | .const _ => 0
  | .add a b => a.slope + b.slope
  | .scale q a => q * a.slope

/-- The residual expression obtained by setting the first variable to zero. -/
def residual (t : Term V (n+1)) : Term V n :=
  t.subst (Fin.cons (.const 0) (.var ·))

theorem eval_cons (t : Term V (n+1)) (x : V) (p : Fin n → V) :
    t.eval (Fin.cons x p) = t.slope • x + t.residual.eval p := by
  induction t with
  | var i => cases i using Fin.cases <;> simp [slope, residual, subst, eval]
  | const => simp [slope, residual, subst, eval]
  | add a b ha hb =>
    simp only [eval, slope, residual, subst, add_smul, eval_subst] at ha hb ⊢
    rw [ha, hb]
    ac_rfl
  | scale q a ha =>
    simp only [eval, slope, residual, subst, eval_subst] at ha ⊢
    rw [ha, smul_add, smul_smul]

end Term

/-- The Boolean algebra generated by strict affine halfspaces. -/
inductive Predicate (V : Type*) (n : ℕ) where
  | ltZero (t : Term V n)
  | neg (φ : Predicate V n)
  | and (φ ψ : Predicate V n)

namespace Predicate

variable [AddCommGroup V] [Module ℚ V] [LT V]

def Holds : Predicate V n → (Fin n → V) → Prop
  | .ltZero t, p => t.eval p < 0
  | .neg φ, p => ¬ φ.Holds p
  | .and φ ψ, p => φ.Holds p ∧ ψ.Holds p

def subst (s : Fin n → Term V m) : Predicate V n → Predicate V m
  | .ltZero t => .ltZero (t.subst s)
  | .neg φ => .neg (φ.subst s)
  | .and φ ψ => .and (φ.subst s) (ψ.subst s)

@[simp] theorem holds_subst (s : Fin n → Term V m) (φ : Predicate V n) (p : Fin m → V) :
    (φ.subst s).Holds p ↔ φ.Holds (fun i => (s i).eval p) := by
  induction φ <;> simp_all [Holds, subst]

def disj (φ ψ : Predicate V n) : Predicate V n := .neg (.and (.neg φ) (.neg ψ))

@[simp] theorem holds_disj (φ ψ : Predicate V n) (p : Fin n → V) :
    (φ.disj ψ).Holds p ↔ φ.Holds p ∨ ψ.Holds p := by
  classical
  by_cases h : φ.Holds p <;> simp [disj, Holds, h]

end Predicate

variable [AddCommGroup V] [Module ℚ V] [LinearOrder V]

/-- A finite Boolean combination of affine inequalities, with vector parameters. -/
def Definable (S : Set (Fin n → V)) : Prop :=
  ∃ φ : Predicate V n, ∀ p, p ∈ S ↔ φ.Holds p

namespace Definable

theorem subst {S : Set (Fin n → V)} (h : Definable S) (s : Fin n → Term V m) :
    Definable {p | (fun i => (s i).eval p) ∈ S} := by
  obtain ⟨φ, hφ⟩ := h
  exact ⟨φ.subst s, fun p => (hφ _).trans (φ.holds_subst s p).symm⟩

theorem compl {S : Set (Fin n → V)} (h : Definable S) : Definable Sᶜ := by
  obtain ⟨φ, hφ⟩ := h
  exact ⟨.neg φ, fun p => not_congr (hφ p)⟩

theorem inter {S T : Set (Fin n → V)} (h : Definable S) (k : Definable T) : Definable (S ∩ T) := by
  obtain ⟨φ, hφ⟩ := h
  obtain ⟨ψ, hψ⟩ := k
  exact ⟨.and φ ψ, fun p => and_congr (hφ p) (hψ p)⟩

theorem union {S T : Set (Fin n → V)} (h : Definable S) (k : Definable T) : Definable (S ∪ T) := by
  obtain ⟨φ, hφ⟩ := h
  obtain ⟨ψ, hψ⟩ := k
  exact ⟨φ.disj ψ, fun p => (or_congr (hφ p) (hψ p)).trans (Predicate.holds_disj _ _ _).symm⟩

end Definable
end KnightModel.RankTwo.Semilinear
